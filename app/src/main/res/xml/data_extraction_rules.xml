<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Diagnostic evidence and owner identifiers are never automatically uploaded by OS backup. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <!-- Preserve owner data during an explicitly selected Android device migration.
         Permission-request history belongs to the old device, not the new installation. -->
    <device-transfer>
        <exclude domain="sharedpref" path="runtime_access.xml" />
    </device-transfer>
</data-extraction-rules>
